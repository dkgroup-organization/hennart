<odoo>
    <record id="spreadsheet_dashboard_rule_authorized_access" model="ir.rule">
        <field name="name">Accès limité aux utilisateurs/équipes autorisés</field>
        <field name="model_id" ref="spreadsheet_dashboard.model_spreadsheet_dashboard"/>
        <field name="domain_force">
            [
                '|',
                    '|',
                        ('authorized_user_ids', 'in', [user.id]),
                        ('authorized_team_ids', 'in', user.crm_team_ids.ids),
                    '&amp;',
                        ('authorized_user_ids', '=', False),
                        ('authorized_team_ids', '=', False),
                        ('group_ids', 'in', user.groups_id.ids)
            ]
        </field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>
</odoo>
