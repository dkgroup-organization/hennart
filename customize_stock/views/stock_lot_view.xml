<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_stock_lot_form_customize" model="ir.ui.view">
            <field name="name">stock.lot.form</field>
            <field name="model">stock.lot</field>
            <field name="inherit_id" ref="stock.view_production_lot_form"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='ref']" position="after">
                    <field name="barcode"/>
                    <field name="barcode_ext"/>
                    <field name="barcode_ext2"/>
                    <field name="blocked"/>
                </xpath>

                <notebook position="inside">
                    <page string="tracking">
                        <button name="action_downstream_move" type="object" string="Ouvrir"/>
                        <group string="Mouvements">
                            <field name="downstream_move"/>
                            <field name="upstream_move"/>
                        </group>
                        <group string="Lots">
                            <field name="upstream_lot"/>
                            <field name="downstream_lot"/>
                        </group>
                    </page>
                </notebook>

            </field>
        </record>

    </data>
</odoo>
