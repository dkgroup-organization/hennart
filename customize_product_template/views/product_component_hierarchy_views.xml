<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_product_component_hierarchy_tree" model="ir.ui.view">
            <field name="name">product.component.hierarchy.tree</field>
            <field name="model">product.component.hierarchy</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="product_tmpl_id"/>
                    <field name="product_id"/>
                    <field name="composant_tmpl_id"/>
                    <field name="composant_id"/>
                    <field name="quantity"/>
                    <field name="level"/>
                    <field name="last_level"/>
                </tree>
            </field>
        </record>

        <record id="action_product_component_hierarchy" model="ir.actions.act_window">
            <field name="name">Product Component Hierarchy</field>
            <field name="res_model">product.component.hierarchy</field>
            <field name="view_mode">tree</field>
        </record>
    </data>
</odoo>
