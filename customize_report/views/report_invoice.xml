<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="document_tax_totals_white">
        <!--
            Generic template to display tax totals in pdf reports.
            Used by invoices, SO and PO.

            ARGUMENTS:
            - tax_totals: dict in the form generated by account.move's _get_tax_totals.
        -->
        <t t-foreach="tax_totals['subtotals']" t-as="subtotal">
            <tr class="border-black" style="background-color: white; color: black; ">
                <td style="background-color: white; color: black; border-right: none;">
                    <span t-esc="subtotal['name']"/>
                </td>

                <td class="text-end" style="background-color: white; color: black; ">
                    <span
                            t-att-class="oe_subtotal_footer_separator"
                            t-esc="subtotal['formatted_amount']"
                    />
                </td>
            </tr>

            <t t-set="subtotal_to_show" t-value="subtotal['name']"/>
            <t t-foreach="tax_totals['groups_by_subtotal'][subtotal_to_show]" t-as="amount_by_group">
                <tr>
                    <t t-if="tax_totals['display_tax_base']">
                        <td style="background-color: white; color: black; border-right: none; ">
                            <span t-esc="amount_by_group['tax_group_name']"/>
                            <span t-if="not amount_by_group['hide_base_amount']" class="text-nowrap">on
                                <t t-esc="amount_by_group['formatted_tax_group_base_amount']"/>
                            </span>
                        </td>
                        <td class="text-end o_price_total" style="background-color: white; color: black; ">
                            <span class="text-nowrap" t-esc="amount_by_group['formatted_tax_group_amount']"/>
                        </td>
                    </t>
                    <t t-else="">
                        <td style="background-color: white; color: black; border-right: none; ">
                            <span class="text-nowrap" t-esc="amount_by_group['tax_group_name']"/>
                        </td>
                        <td class="text-end o_price_total" style="background-color: white; color: black; ">
                            <span class="text-nowrap" t-esc="amount_by_group['formatted_tax_group_amount']"/>
                        </td>
                    </t>
                </tr>
            </t>
        </t>

        <t t-if="'formatted_rounding_amount' in tax_totals and tax_totals['rounding_amount'] != 0">
            <td style="background-color: white; color: black; ">Rounding</td>
            <td class="text-end" style="background-color: white; color: black; ">
                <span t-esc="tax_totals['formatted_rounding_amount']"/>
            </td>
        </t>

        <!--Total amount with all taxes-->
        <tr class="border-black" style="background-color: white; color: black; ">
            <td style="background-color: white; color: black; border-color: black;">
                <span>Total</span>
            </td>
            <td class="text-end" style="background-color: white; color: black; ">
                <span t-esc="tax_totals['formatted_amount_total_rounded']"
                      t-if="'formatted_amount_total_rounded' in tax_totals"/>
                <span t-esc="tax_totals['formatted_amount_total']" t-else=""/>
            </td>
        </tr>
    </template>

    <template id="incoterm_info">
        <p t-if="o.partner_id.incoterm_id" style="margin-bottom: 0;">INCOTERM:
            <span t-field="o.partner_id.incoterm_id.code"/>
        </p>
        <p t-if="o.partner_id.oeri_code" style="margin-bottom: 0;">EORI:
            <span t-field="o.partner_id.oeri_code"/>
        </p>
        <p t-if="o.partner_id.incoterm_contact_id"  style="margin-bottom: 0;">Contact:
            <span t-field="o.partner_id.incoterm_contact_id.name"/>
        </p>
        <p t-if="o.partner_id.incoterm_contact_id.email"  style="margin-bottom: 0;">Email:
            <span t-field="o.partner_id.incoterm_contact_id.email"/>
        </p>
    </template>

    <template id="report_invoice_document_inherits" inherit_id="account.report_invoice_document"
              priority="100"
    >
        <xpath expr="//div[@class='row']" position="replace">
            <div class="row">
                <t t-if="o.partner_shipping_id and (o.partner_shipping_id != o.partner_id)">
                    <div class="col-6">
                        <t t-set="information_block">
                            <div groups="account.group_delivery_invoice_address" name="shipping_address_block">
                                <strong>Shipping Address:</strong>
                                <div t-field="o.partner_shipping_id"
                                     t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: True}"/>
                            </div>
                        </t>
                    </div>
                    <div class="col-6" name="address_not_same_as_shipping">
                        <t t-set="address">
                            <address class="mb-0" t-field="o.partner_id"
                                     t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: True}"/>
                            <div t-if="o.partner_id.vat" id="partner_vat_address_not_same_as_shipping">
                                <t t-if="o.company_id.account_fiscal_country_id.vat_label"
                                   t-esc="o.company_id.account_fiscal_country_id.vat_label" id="inv_tax_id_label"/>
                                <t t-else="">Tax ID</t>:
                                <span t-field="o.partner_id.vat"/>
                            </div>
                            <t t-call="customize_report.incoterm_info"/>
                        </t>
                    </div>
                </t>
                <t t-elif="o.partner_shipping_id and (o.partner_shipping_id == o.partner_id)">
                    <div class="offset-col-6 col-6" name="address_same_as_shipping">
                        <t t-set="address">
                            <address class="mb-0" t-field="o.partner_id"
                                     t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: True}"/>
                            <div t-if="o.partner_id.vat" id="partner_vat_address_same_as_shipping">
                                <t t-if="o.company_id.account_fiscal_country_id.vat_label"
                                   t-esc="o.company_id.account_fiscal_country_id.vat_label" id="inv_tax_id_label"/>
                                <t t-else="">Tax ID</t>:
                                <span t-field="o.partner_id.vat"/>
                            </div>
                            <t t-call="customize_report.incoterm_info"/>
                        </t>
                    </div>
                </t>
                <t t-else="">
                    <div class="offset-col-6 col-6" name="no_shipping">
                        <t t-set="address">
                            <address class="mb-0" t-field="o.partner_id"
                                     t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: True}"/>
                            <div t-if="o.partner_id.vat" id="partner_vat_no_shipping">
                                <t t-if="o.company_id.account_fiscal_country_id.vat_label"
                                   t-esc="o.company_id.account_fiscal_country_id.vat_label" id="inv_tax_id_label"/>
                                <t t-else="">Tax ID</t>:
                                <span t-field="o.partner_id.vat"/>
                            </div>
                            <t t-call="customize_report.incoterm_info"/>
                        </t>
                    </div>
                </t>
            </div>

        </xpath>

        <xpath expr="//div[@class='page']" position="replace">

            <div id="informations" class="row mt-1 mb-1">
                <div class="col-auto text-center col-3 mw-100 mb-1" name="invoice_date"
                     style="border: 1px solid black !important;">
                    <h5>Date:
                        <p t-if="o.invoice_date" t-field="o.invoice_date"/>
                    </h5>

                </div>
                <div class="col-auto text-center col-3 mw-100 mb-1"
                     t-if="not (env.context.get('delivery', False) or is_delivery)" name="invoice_name"
                     style="border: 1px solid black !important;">
                    <h5>
                        <t t-if="o.move_type == 'out_invoice' and o.state == 'posted'">Invoice</t>
                        <t t-if="o.move_type == 'out_invoice' and o.state == 'draft'">Draft Invoice</t>
                        <t t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">Cancelled Invoice</t>
                        <t t-if="o.move_type == 'out_refund'">Refund</t>
                        <t t-if="o.move_type == 'in_refund'">Supplier Refund</t>
                        <t t-if="o.move_type == 'in_invoice'">Supplier Invoice</t>
                        <p t-if="o.name != '/'" t-field="o.name"/>
                    </h5>
                </div>
                <div class="col-auto text-center col-3 mw-100 mb-1" name="partner_id"
                     style="border: 1px solid black !important;">
                    <h5>Delivery:
                        <p t-if="o.picking_ids" t-field="o.picking_ids[0].name"/>
                    </h5>
                </div>
                <div class="col-auto text-center col-3 mw-100 mb-1" name="customer_ref"
                     style="border: 1px solid black !important;">
                    <h5>Customer:
                        <p t-if="o.partner_id.ref" t-field="o.partner_id.ref"/>
                    </h5>
                </div>
                <div class="col-auto text-center col-3 mw-100 mb-1" name="client_code"
                     style="border: 1px solid black !important;">
                    <h5>Reference:
                        <p t-if="o.partner_id.ref" t-field="o.invoice_origin"/>
                    </h5>
                </div>
            </div>


            <style>
                .small-header {
                font-size: 10px;
                }
                .small-text {
                font-size: 10px;
                color: black;
                }
                .small-text2 {
                font-size: 8px;
                color: black;
                }
                .p_name {
                margin-top: 0;
                margin-bottom: 0;
                }

            </style>

            <table class="table table-sm o_main_table table-borderless" name="invoice_line_table">
                <thead>
                    <tr>
                        <th name="th_code" class="text-start small-header">
                            <span>Code</span>
                        </th>
                        <th name="th_ean" class="text-start small-header">
                            <span>EAN</span>
                        </th>
                        <th name="th_quantity" class="text-end small-header">
                            <span>Qty</span>
                        </th>
                        <th name="th_description" class="text-start small-header">
                            <span>Product</span>
                        </th>
                        <th name="th_colis_de" class="text-end small-header">
                            <span>Pack
                                <br/>
                                of
                            </span>
                        </th>
                        <th name="th_unite" class="text-end small-header">
                            <span>Unit</span>
                        </th>
                        <th name="th_priceunit"
                            t-attf-class="small-header text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                            <span>Unit
                                <br/>
                                price
                            </span>
                        </th>
                        <th name="th_price_unit"
                            t-attf-class="small-header text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                            <span>Disc %</span>
                        </th>
                        <th name="th_prix_net" class="small-header text-end small-header">
                            <span>Net
                                <br/>
                                price
                            </span>
                        </th>
                        <th name="th_taxes"
                            t-attf-class="small-header text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                            <span>Tax %</span>
                        </th>
                        <th name="th_subtotal" class="text-end small-header">
                            <span groups="account.group_show_line_subtotals_tax_excluded">Amount</span>
                            <span groups="account.group_show_line_subtotals_tax_included">Total Price</span>
                        </th>
                    </tr>
                </thead>
                <tbody class="invoice_tbody">
                    <t t-set="current_subtotal" t-value="0"/>
                    <t t-set="lines"
                       t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>

                    <t t-foreach="lines" t-as="line">
                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"
                           groups="account.group_show_line_subtotals_tax_excluded"/>
                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_total"
                           groups="account.group_show_line_subtotals_tax_included"/>

                        <tr t-att-class="'bg-200 fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                            <t t-if="line.display_type == 'product'" name="account_invoice_line_accountable">
                                <td name="code" class="small-text">
                                    <span t-field="line.product_id.default_code"/>
                                </td>
                                <td name="ean" class="small-text">
                                    <span t-field="line.product_id.barcode"/>
                                    <t t-if="o.fiscal_position_id.country_id and o.fiscal_position_id.country_id.code == 'GB'">
                                        <br></br>
                                        <span t-field="line.product_id.hs_code_id.local_code"/>
                                    </t>
                                </td>
                                <td class="small-text text-end">
                                    <span t-field="line.uom_qty"/>
                                    <!-- <span t-field="line.product_uom_id" groups="uom.group_uom"/> -->
                                </td>
                                <td name="account_invoice_line_name" class="small-text">
                                    <span t-field="line.product_id.name"/>

                                    <t t-foreach="line.get_move_line_lot()" t-as="move">
                                        <p class="p_name">
                                            Lot:
                                            <span t-esc="move['name']"/>
                                            |
                                            <span t-esc="move['expiration_date']"/>
                                            | QTE:
                                            <span t-esc="move['text_uom_qty']"/>
                                        </p>

                                    </t>
                                    <t t-if="o.fiscal_position_id.country_id and o.fiscal_position_id.country_id.code == 'GB'">
                                        <p class="small-text2 p_name">
                                            <span t-field="line.product_id.type_milk"/>
                                            <span t-field="line.product_id.heat_treatment_milk"/>
                                            milk from
                                            <t t-if="line.product_id.origin_country_id">
                                                <span t-field="line.product_id.origin_country_id.name"/>
                                            </t>
                                            <t t-if="not line.product_id.origin_country_id">
                                                <span>France</span>
                                            </t>
                                            (
                                            <span t-field="line.weight"
                                                  t-options='{"widget": "float", "precision": 3}'/>
                                            kg)
                                        </p>
                                    </t>

                                </td>
                                <td class="small-text text-end" name="colis_de">
                                    <span t-if="line.product_id.base_unit_count > 1"
                                          t-field="line.product_id.base_unit_count"
                                          t-options='{"widget": "float", "precision": 0}'/>
                                </td>
                                <td class="small-text text-end" name="unite">
                                    <span t-field="line.quantity"
                                          t-options='{"widget": "float", "precision": 3}'/>
                                    <span t-field="line.product_uos"/>
                                </td>
                                <td t-attf-class="small-text text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                    <span class="text-nowrap" t-field="line.price_unit"
                                          t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                                <td t-attf-class="small-text text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                    <span class="text-nowrap" t-field="line.discount"
                                          t-options='{"widget": "float", "precision": 1}'/>
                                </td>

                                <td class="small-text text-end" name="prix_net">
                                    <span t-field="line.price_net"/>
                                </td>
                                <td t-attf-class="small-text text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                    <span t-esc="', '.join(map(lambda x: (x.description or x.name), line.tax_ids))"
                                          id="line_tax_ids"/>
                                </td>
                                <td class="small-text text-end">
                                    <span class="text-nowrap" t-field="line.price_subtotal"
                                          groups="account.group_show_line_subtotals_tax_excluded"/>
                                    <span class="text-nowrap" t-field="line.price_total"
                                          groups="account.group_show_line_subtotals_tax_included"/>
                                </td>
                            </t>
                            <t t-if="line.display_type == 'line_section'">
                                <td colspan="99">
                                    <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                </td>
                                <t t-set="current_section" t-value="line"/>
                                <t t-set="current_subtotal" t-value="0"/>
                            </t>
                            <t t-if="line.display_type == 'line_note'">
                                <td colspan="99">
                                    <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                </td>
                            </t>
                        </tr>

                        <t t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">
                            <tr class="is-subtotal text-end">
                                <td colspan="99">
                                    <strong class="mr16">Subtotal</strong>
                                    <span t-esc="current_subtotal"
                                          t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                </td>
                            </tr>
                        </t>
                    </t>
                </tbody>
            </table>

            <div class="clearfix mb-4">
                <div id="total" class="row">
                    <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ms-auto">
                        <table class="table table-sm table-borderless" style="page-break-inside: avoid;">

                            <!--Tax totals-->
                            <t t-set="tax_totals" t-value="o.tax_totals"/>
                            <t t-call="customize_report.document_tax_totals_white"/>

                        </table>
                    </div>
                </div>
            </div>

            <t t-if="o.fiscal_position_id.country_id and o.fiscal_position_id.country_id.code == 'GB'">
                <div class="row mt-1 mb-1" style="text-align: center !important;">
                    <div class="col-auto col-3 mw-100 mb-0">
                        <strong>Incoterm:</strong>
                        <p class="m-0">
                            <span t-field="o.partner_id.incoterm_id.code"/>
                            -
                            <span t-field="o.partner_id.incoterm_id.name"/>
                        </p>
                    </div>
                    <div class="col-auto col-3 mw-100 mb-0">
                        <strong>Date of arrival in UK:</strong>
                        <p class="m-0">
                            <span t-field="o.incoterm_date"/>
                        </p>
                    </div>
                    <div class="col-auto col-3 mw-100 mb-0">
                        <strong>Port of entry:</strong>
                        <p class="m-0">
                            <t t-if="o.incoterm_port">
                                <span t-field="o.incoterm_port"/>
                            </t>
                            <t t-if="not o.incoterm_port">
                                Folkestone
                            </t>
                        </p>
                    </div>

                </div>
            </t>

            <p t-if="o.invoice_date_due" name="invoice_date_due" style="font-weight: bold !important;">
                <span>Due date:</span>
                <span t-field="o.invoice_date_due"/>
            </p>

            <p class="small-text2" style="line-height: 8px;" t-field="o.company_id.invoice_footer_text"/>
            <p class="small-text2" style="line-height: 8px;" name="note"
               t-if="not is_html_empty(o.fiscal_position_id.note)" t-field="o.fiscal_position_id.note"/>

            <div class="row mt-1 mb-1" style="text-align: center !important;" t-if="o.picking_ids">
                <div class="col-auto  text-center col-3 mw-100 mb-2" name="due_date"
                     style="border: 1px solid black !important;">
                    <strong>Carrier:</strong>
                    <p class="m-0" t-field="o.picking_ids[0].carrier_id"/>
                </div>
                <div class="col-auto  text-center col-3 mw-100 mb-2" name="partner_id"
                     style="border: 1px solid black !important;">
                    <strong>Nb pack:</strong>
                    <p class="m-0" t-field="o.picking_ids[0].number_of_packages"/>
                </div>
                <div class="col-auto  text-center col-3 mw-100 mb-2" name="customer_ref"
                     style="border: 1px solid black !important;">
                    <strong>Nb container:</strong>
                    <p class="m-0" t-field="o.picking_ids[0].nb_container"/>
                </div>
                <div class="col-auto  text-center col-3 mw-100 mb-2"
                     style="border: 1px solid black !important;">
                    <strong>Nb pallet:</strong>
                    <p class="m-0" t-field="o.picking_ids[0].nb_pallet"/>
                </div>
                <div class="col-auto  text-center col-3 mw-100 mb-2"
                     style="border: 1px solid black !important;">
                    <strong>Weight:</strong>
                    <p class="m-0" t-field="o.picking_ids[0].weight"/>
                </div>
                <div class="col-auto  text-center col-3 mw-100 mb-2"
                     style="border: 1px solid black !important;">
                    <strong>Gross weight:</strong>
                    <p class="m-0" t-field="o.picking_ids[0].shipping_weight"/>
                </div>
            </div>


        </xpath>

    </template>


</odoo>