<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_delivery_document_hennart">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-set="o" t-value="o.with_context(lang=o._get_report_lang())"/>
                <t t-set="partner" t-value="o.partner_id or (o.move_ids and o.move_ids[0].partner_id) or False"/>

                <t t-set="address" style="margin-top: -30px;">
                    <div name="div_outgoing_address">
                        <div name="outgoing_delivery_address"
                             t-if="o.should_print_delivery_address()">
                            <span>
                                <strong>Delivery Address:</strong>
                            </span>
                            <div t-field="o.move_ids[0].partner_id"
                                 t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'/>
                        </div>
                    </div>
                </t>

                <t t-if="o.state != 'done'">
                    <div style="margin-top: 10px;">
                        <img src="/customize_report/static/img/preparation.png" style="width: 100px; height: auto;"/>
                        <span>Preparation en cours (Informations non confirmées, ne pas envoyer au client)</span>
                    </div>
                </t>
                <div class="page">
                    <h2>
                        <t t-if="o.picking_type_id.code == 'outgoing'">Delivery:</t>
                        <span t-field="o.name"/>
                    </h2>
                    <style>
                    .small-header {
                    font-size: 12px;
                    }
                    .small-text {
                    font-size: 12px;
                    color: black;
                    }
                    .small-text2 {
                    font-size: 10px;
                    color: black;
                    }
                    .p_name {
                    margin-top: 0;
                    margin-bottom: 0;
                    }
                    </style>

                    <table class="table table-sm o_main_table table-borderless small-text"
                           name="stock_move_table_header">
                        <thead>
                            <tr>
                                <th class="text-center">
                                    <strong>Customer ref:</strong>
                                </th>
                                <th>
                                    <strong>Pallets:</strong>
                                </th>
                                <th class="text-center">
                                    <strong>Containers:</strong>
                                </th>
                                <th class="text-center">
                                    <strong>Weight:</strong>
                                </th>
                                <th class="text-center">
                                    <strong>Order:</strong>
                                </th>
                                <th class="text-center">
                                    <strong>Date:</strong>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="text-center">
                                    <span t-field="o.partner_id.ref"/>
                                </td>
                                <td class="text-center">
                                    <span t-field="o.nb_pallet"/>
                                </td>
                                <td class="text-center">
                                    <span t-field="o.nb_container"/>
                                </td>
                                <td class="text-center">
                                    <span t-field="o.weight"/>
                                </td>
                                <td class="text-center">
                                    <t t-if="o.picking_type_code == 'outgoing'">
                                        <span t-field="o.sale_reference"/>
                                    </t>
                                    <t t-else="">
                                        <span t-field="o.partner_origin"/>
                                    </t>
                                </td>
                                <td style="background-color: white; color: #495057;" class="text-center">
                                    <t t-if="o.state == 'done'">
                                        <span>
                                            <t t-esc="o.date_done.strftime('%Y-%m-%d')"/>
                                        </span>
                                    </t>
                                    <t t-if="o.state != 'done'">
                                        <span>
                                            <t t-esc="o.scheduled_date.strftime('%Y-%m-%d')"/>
                                        </span>
                                    </t>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <table class="table table-sm o_main_table table-borderless small-text" name="stock_move_table">
                        <thead>
                            <tr>
                                <th name="th_sm_code">
                                    <span>Code</span>
                                </th>
                                <th name="th_sm_qty">
                                    <span>Qty</span>
                                </th>
                                <th name="th_sm_product">
                                    <span>Product</span>
                                </th>
                                <th name="th_sm_colisage">
                                    <span>Pack of</span>
                                </th>
                                <th name="th_sm_unite">
                                    <span>Unit</span>
                                </th>
                                <th name="th_sm_production_lot" style="background-color: white; color: #495057;">
                                    <span>Production lot</span>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="lines" t-value="o.move_ids.filtered(lambda x: x.product_uom_qty)"/>
                            <tr t-foreach="lines" t-as="move">
                                <!-- Code -->
                                <td>
                                    <t t-if="move.bom_line_id.bom_id.type == 'phantom'">
                                        <span t-field="move.bom_line_id.bom_id.product_tmpl_id.default_code"/>
                                    </t>
                                    <t t-else="">
                                        <span t-field="move.product_id.default_code"/>
                                    </t>
                                </td>

                                <!-- QTE -->
                                <td class="text-center">
                                    <t t-if="move.bom_line_id.bom_id.type == 'phantom'">
                                        <t t-set="qty_pack" t-value="move.bom_line_id.bom_id.base_unit_count"/>
                                        <t t-set="qty_total" t-value="move.quantity_done / qty_pack"/>
                                        <t t-esc="qty_total" t-options='{"widget": "float", "precision": 1}'/>
                                    </t>
                                    <t t-else="">
                                        <span t-field="move.quantity_done"
                                              t-options='{"widget": "float", "precision": 1}'/>
                                        <t t-if="o.state != 'done'">
                                            &#47;<span t-field="move.product_uom_qty"
                                              t-options='{"widget": "float", "precision": 1}'/>
                                        </t>
                                    </t>

                                </td>

                                <!-- Produit -->
                                <td>
                                    <t t-if="move.bom_line_id.bom_id.type == 'phantom'">
                                        <span t-esc="move.bom_line_id.bom_id.product_tmpl_id.name"/>
                                    </t>
                                    <t t-else="">
                                        <span t-esc="move.product_id.name"/>
                                    </t>
                                </td>

                                <!-- Colisage -->
                                <td class="text-center">
                                    <t t-if="move.bom_line_id">
                                        <span t-field="move.bom_line_id.bom_id.base_unit_count"
                                              t-options='{"widget": "float", "precision": 0}'/>
                                    </t>
                                </td>

                                <!-- Unité -->
                                <td class="text-center">
                                    <t t-if="move.product_id.uos_id.id == 1">
                                        <span t-field="move.quantity_done"/>
                                        <span t-field="move.product_id.uos_id"/>
                                    </t>
                                    <t t-else="">
                                        <span t-field="move.weight"/>
                                        <span t-field="move.product_id.uos_id"/>
                                    </t>

                                </td>

                                <td style="background-color: white; color: #495057;">
                                    <!-- Lot de production -->
                                    <span t-field="move.lot_description"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

    <template id="report_delivery_hennart">
        <t t-foreach="docs" t-as="o">
            <t t-call="customize_report.report_delivery_document_hennart" t-lang="o._get_report_lang()"/>
        </t>
    </template>


</odoo>