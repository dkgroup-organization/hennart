<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="stock_picking_print_form_view" model="ir.ui.view">
            <field name="name">stock.picking.form</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <header position="inside">
                    <button name="button_print_invoice"
                            attrs="{'invisible': ['|',('state', '!=', 'done'), ('picking_type_code', '!=', 'outgoing')]}"
                            string="Print Invoice" type="object" class="oe_highlight"/>
                    <button name="button_print_picking"
                            attrs="{'invisible': [('picking_type_code', '!=', 'outgoing')]}"
                            string="Print Picking" type="object" class="oe_highlight"/>
                    <button name="print_chronopost"
                            attrs="{'invisible': ['|', '|', '|', ('picking_type_code', '!=', 'outgoing'), ('state', 'in', ('cancel', 'draft')), ('delivery_type', '!=', 'chronopost'), ('sscc_line_ids', '=', False)]}"
                            string="Print Chronopost" type="object" class="oe_highlight"/>
                </header>
            </field>
        </record>

    </data>
</odoo>
