<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="stock_picking_form_view_labels" model="ir.ui.view">
            <field name="name">stock.picking.form.labels</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">

                <header position="inside">
                    <button name="open_label_wizard" string="Print Labels" type="object" class="btn-primary"
                   attrs="{'invisible': [('picking_type_code', '!=', 'incoming')]}"/>
                </header>

            </field>
        </record>
    </data>
</odoo>
