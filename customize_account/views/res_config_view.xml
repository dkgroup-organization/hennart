<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_it_config_settings" model="ir.ui.view">
            <field name="name">account settings</field>
            <field name="model">res.config.settings</field>
            <field name="priority">10</field>
            <field name="inherit_id" ref="account.res_config_settings_view_form"/>
            <field name="arch" type="xml">

                <xpath expr="//div[hasclass('settings')]" position="inside">
                    <div class="app_settings_block" data-string="Workshop Settings" string="Parametres Hennart">
                        <h2>Workshop Configuration</h2>
                        <div class="row mt16">
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane">

                                </div>
                                <div class="o_setting_right_pane">
                                    <span class="text-muted">
                                        Coefficient de coût Atelier.
                                    </span>
                                    <field name="coef_workshop_cost"/>
                                    <button name="update_workshop_cost" type="object" string="Update"
                                            class="oe_inline"/>
                                </div>
                            </div>
                        </div>
                        <div class="row mt16">
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane">

                                </div>
                                <div class="o_setting_right_pane">
                                    <span class="text-muted">
                                        Coefficient poids BRUT / poids NET.
                                    </span>
                                    <field name="coef_shipping_weight"/>

                                </div>
                            </div>
                        </div>
                    </div>
                </xpath>

            </field>
        </record>
    </data>
</odoo>
