<?xml version="1.0" encoding="UTF-8"?>
<odoo>

   <record id="view_lot_tree_inherit_update_button" model="ir.ui.view">
        <field name="name">stock.lot.tree.inherit.update.button</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_tree"/>
        <field name="arch" type="xml">

            <xpath expr="//tree" position="inside">

                     <header>
                    <button name="compute_cost_price"
                            string="Mettre à jour"
                            type="object"
                            class="oe_highlight"
                            icon="fa-refresh"/>
                </header>

                    <field name="unit_weight" optional="show"/>
                    <field name="unit_price" optional="show"/>
                    <field name="kg_price" optional="show"/>
                    <field name="uos_po_id" optional="show"/>
            </xpath>

        </field>
    </record>

    <record id="view_stock_lot_form_account_inherit" model="ir.ui.view">
        <field name="name">stock.lot.form.inherit</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">

            <notebook position="inside">
                <page string="Account" groups="account.group_account_readonly">
                    <group>
                        <group>
                            <field name="unit_weight"/>
                            <field name="unit_price"/>
                            <field name="kg_price"/>
                            <field name="uos_po_id"/>
                            <field name="uos_id"/>
                            <field name="partner_supplier_id"/>
                            <field name="is_weight_based" readonly="True"/>
                        </group>
                        <group>
                            <button name="compute_cost_price" string="Update" type="object"/>
                        </group>
                    </group>
                </page>
            </notebook>

        </field>
    </record>

    <record id="search_product_lot_filter_panel" model="ir.ui.view">
        <field name="name">stock.lot.form.inherit</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.search_product_lot_filter"/>
        <field name="arch" type="xml">

            <xpath expr="//search" position="inside">
                <searchpanel>
                    <field name="categ_id" icon="fa-product" enable_counters="1"/>
                </searchpanel>
            </xpath>

        </field>
    </record>

</odoo>
