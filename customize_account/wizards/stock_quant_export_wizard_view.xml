<odoo>
    <record id="view_stock_quant_export_wizard" model="ir.ui.view">
        <field name="name">stock.quant.export.wizard.form</field>
        <field name="model">stock.quant.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Stock Quantities">
                <group>
                    <field name="date" required="1"/>
                </group>
                <footer>
                    <button name="action_export" type="object" string="Export" class="btn-primary"/>
                    <button string="Cancel" class="btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <act_window id="action_stock_quant_export"
                name="Stock à date"
                res_model="stock.quant.export.wizard"
                view_mode="form"
                target="new"/>

    <menuitem id="menu_stock_quant_export" parent="stock.menu_warehouse_report" sequence="75" action="action_stock_quant_export"/>

</odoo>
